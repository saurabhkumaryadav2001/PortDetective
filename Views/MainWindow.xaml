<Window x:Class="PortDetective.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PortDetective.ViewModels"
        xmlns:conv="clr-namespace:PortDetective.Converters"
        mc:Ignorable="d"
        Title="Port Detective"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UIFont}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:StateToColorConverter     x:Key="StateToColor" />
        <conv:BoolToBrushConverter      x:Key="BoolToBrush" />
        <conv:InverseBoolConverter      x:Key="InverseBool" />
        <conv:StringToBoolConverter     x:Key="StrToBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Title bar -->
            <RowDefinition Height="Auto" />  <!-- Search/controls bar -->
            <RowDefinition Height="Auto" />  <!-- Quick ports -->
            <RowDefinition Height="*" />     <!-- Main content (grid + details) -->
            <RowDefinition Height="Auto" />  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             TITLE BAR
        ============================================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Shield Icon (Unicode) -->
                        <TextBlock Text="🔍" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Port Detective"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Find what's using your localhost ports"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="32,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Refresh button -->
                    <Button Content="⟳  Refresh"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Refresh port list" />

                    <!-- Auto-refresh toggle -->
                    <ToggleButton x:Name="AutoRefreshToggle"
                                  Width="44" Height="24"
                                  IsChecked="{Binding AutoRefreshEnabled, Mode=TwoWay}"
                                  ToolTip="Toggle auto-refresh">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="track"
                                        Width="44" Height="24" CornerRadius="12"
                                        Background="{StaticResource BorderBrush}">
                                    <Border x:Name="thumb"
                                            Width="18" Height="18" CornerRadius="9"
                                            Background="{StaticResource TextMutedBrush}"
                                            HorizontalAlignment="Left"
                                            Margin="3,0,0,0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="thumb" Property="Background" Value="White" />
                                        <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="Auto" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="6,0,12,0" />

                    <!-- Settings -->
                    <Button Content="⚙"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding OpenSettingsCommand}"
                            FontSize="16"
                            ToolTip="Settings"
                            Padding="10,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             CONTROL BAR — Port lookup + range scan + search
        ============================================================ -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Single port -->
                <TextBlock Grid.Column="0" Text="Port:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,8,0" />
                <TextBox Grid.Column="1"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}"
                         Width="90"
                         KeyDown="PortInput_KeyDown" />

                <!-- Find Process button -->
                <Button Grid.Column="1" Content="Find"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding FindProcessCommand}"
                        Margin="100,0,0,0"
                        Padding="10,7" />

                <!-- Divider -->
                <Rectangle Grid.Column="2" Width="1" Fill="{StaticResource BorderBrush}" Margin="0,4" />

                <!-- Range scan -->
                <TextBlock Grid.Column="3" Text="Range:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,8,0" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding RangeStart, UpdateSourceTrigger=PropertyChanged}"
                             Width="70" />
                    <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding RangeEnd, UpdateSourceTrigger=PropertyChanged}"
                             Width="70" />
                </StackPanel>
                <Button Grid.Column="5" Content="Scan Range"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ScanRangeCommand}"
                        Margin="8,0,0,0" />

                <!-- Divider -->
                <Rectangle Grid.Column="6" Width="1" Fill="{StaticResource BorderBrush}" Margin="0,4" />

                <!-- Search box -->
                <Grid Grid.Column="7">
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource UIFont}" />
                    <TextBlock Text="🔍  Search by port, process, PID..."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0"
                               Visibility="{Binding SearchQuery, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <Button Content="✕"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Padding="8,5"
                            Visibility="{Binding SearchQuery, Converter={StaticResource NullToVis}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================
             QUICK PORTS BAR
        ============================================================ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10">
            <DockPanel>
                <TextBlock Text="QUICK PORTS"
                           Style="{StaticResource SectionHeaderStyle}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Margin="0,0,16,0" />
                <ItemsControl ItemsSource="{Binding QuickPorts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource QuickPortButtonStyle}"
                                    Background="{Binding IsInUse, Converter={StaticResource BoolToBrush}}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Command="{Binding DataContext.QuickPortCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" />
                                    <Ellipse Width="6" Height="6" Margin="5,0,0,0"
                                             Fill="{StaticResource SuccessBrush}"
                                             Visibility="{Binding IsInUse, Converter={StaticResource BoolToVis}}"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ============================================================
             MAIN CONTENT — Port list + Details panel
        ============================================================ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Error message -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#2D1A1A"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Top" Panel.ZIndex="10">
                <DockPanel>
                    <TextBlock Text="⚠  " Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}" />
                </DockPanel>
            </Border>

            <!-- Port DataGrid -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section header -->
                <Border Grid.Row="0"
                        Padding="20,10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="ACTIVE PORTS"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   VerticalAlignment="Center" Margin="0" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding FilteredPortCount, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding TotalPortCount, Mode=OneWay}" />
                                <Run Text=" ports" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredPorts}"
                          SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                          Margin="0"
                          Padding="0,4">
                    <DataGrid.Columns>
                        <!-- Port -->
                        <DataGridTemplateColumn Header="PORT" Width="80" SortMemberPath="Port">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Port}"
                                               FontFamily="{StaticResource CodeFont}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- PID -->
                        <DataGridTemplateColumn Header="PID" Width="70" SortMemberPath="ProcessId">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProcessId}"
                                               FontFamily="{StaticResource CodeFont}"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Process -->
                        <DataGridTemplateColumn Header="PROCESS" Width="160" SortMemberPath="ProcessName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProcessNameDisplay}"
                                               FontFamily="{StaticResource CodeFont}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Protocol -->
                        <DataGridTemplateColumn Header="PROTO" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Protocol}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="STATUS" Width="110" SortMemberPath="ConnectionState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeStyle}"
                                            Background="{Binding ConnectionState, Converter={StaticResource StateToColor}}"
                                            Opacity="0.85"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusBadge}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Executable path -->
                        <DataGridTemplateColumn Header="PATH" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExecutablePath}"
                                               FontFamily="{StaticResource CodeFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExecutablePath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Stop"
                                            Style="{StaticResource DangerButtonStyle}"
                                            FontSize="11" Padding="8,3"
                                            Command="{Binding DataContext.KillProcessCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            IsEnabled="{Binding IsSystemProcess, Converter={StaticResource InverseBool}}"
                                            ToolTip="Stop this process" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Busy overlay -->
                <Border Grid.Row="1"
                        Background="#88000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⟳" FontSize="32"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Stretch" />

            <!-- Details Panel -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                <!-- No selection placeholder -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis},
                                         ConverterParameter=invert}">
                    <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center"
                               Opacity="0.3" />
                    <TextBlock Text="Select a port to view details"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>

                <!-- Details content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="16" DataContext="{Binding DetailsViewModel}">

                        <!-- Header -->
                        <TextBlock Text="SELECTED PROCESS"
                                   Style="{StaticResource SectionHeaderStyle}" />

                        <!-- Process name -->
                        <TextBlock Text="{Binding ProcessName}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <!-- System process warning -->
                        <Border Background="#2D2415"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="10,7" Margin="0,0,0,12"
                                Visibility="{Binding IsSystemProcess, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⚠  Critical system process — cannot be terminated"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <!-- Detail rows -->
                        <ItemsControl>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Style="{StaticResource DetailLabelStyle}"
                                                   Text="{Binding Label}" DockPanel.Dock="Left" />
                                        <TextBlock Style="{StaticResource DetailValueStyle}"
                                                   Text="{Binding Value}"
                                                   ToolTip="{Binding Value}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Inline detail fields -->
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="PID" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Text="{Binding ProcessId}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Port" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Text="{Binding Port}"
                                       Foreground="{StaticResource AccentBrush}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="State" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Text="{Binding ConnectionState}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Started" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Text="{Binding StartTime}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="User" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Text="{Binding UserName}" />
                        </DockPanel>
                        <Separator />
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Path" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Text="{Binding ExecutablePath}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ExecutablePath}" />
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <TextBlock Style="{StaticResource DetailLabelStyle}" Text="Command" />
                            <TextBlock Style="{StaticResource DetailValueStyle}"
                                       Text="{Binding CommandLine}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CommandLine}" />
                        </DockPanel>

                        <Separator />

                        <!-- Action buttons -->
                        <TextBlock Text="ACTIONS"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="0,4,0,8" />

                        <WrapPanel>
                            <Button Content="📂 Open Location"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DataContext.OpenFileLocationCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,6,6"
                                    FontSize="11" />
                            <Button Content="📋 Copy PID"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DataContext.CopyPidCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,6,6"
                                    FontSize="11" />
                            <Button Content="📋 Copy Port"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DataContext.CopyPortCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,6,6"
                                    FontSize="11" />
                            <Button Content="📋 Copy Path"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DataContext.CopyPathCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,6,6"
                                    FontSize="11" />
                        </WrapPanel>

                        <Button Content="⏹  Stop Process"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DataContext.KillProcessCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                HorizontalAlignment="Stretch"
                                Margin="0,4,0,0" />

                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             STATUS BAR
        ============================================================ -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding LastRefreshTime}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" />
            </DockPanel>
        </Border>

    </Grid>
</Window>
